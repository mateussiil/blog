# Comentários nos posts. Configure estas variáveis no Coolify (aplicação do blog).

# Obrigatória para os comentários funcionarem. Sem ela o blog funciona, mas não dá para comentar.
DATABASE_URL=postgres://usuario:senha@host:5432/blog

# Avisos por e-mail (opcionais). Sem RESEND_API_KEY, os comentários funcionam e os avisos são pulados.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend.
COMMENTS_FROM="Mateus Silva <comentarios@mateussiil.com.br>"
# Para onde vai o aviso de cada comentário novo.
AUTHOR_EMAIL=
