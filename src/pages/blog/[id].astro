---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { copy } from '../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = copy[post.data.lang];
const originHost = post.data.originalUrl && new URL(post.data.originalUrl).hostname.replace(/^www\./, '');
const originName = originHost?.includes('medium.com') ? 'Medium' : originHost;
---
<BaseLayout
  title={`${post.data.title} — Mateus Silva`}
  description={post.data.excerpt}
  lang={post.data.lang}
  canonical={`/blog/${post.id}/`}
>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time class="mono" datetime={post.data.date.toISOString()}>{t.date(post.data.date, 'long')}</time>
        <button type="button" class="comments-toggle mono" data-comments-toggle aria-pressed="true" hidden></button>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.themes.length > 0 && (
        <p class="post-themes">{post.data.themes.map((id) => t.themes[id]).join(', ')}</p>
      )}
    </header>
    <div class="prose" data-comments-text>
      <Content />
    </div>
    <Comments postId={post.id} lang={post.data.lang} />
    <footer class="post-footer">
      {post.data.originalUrl && (
        <p>{t.post.original} <a href={post.data.originalUrl} rel="noreferrer">{originName}</a>.</p>
      )}
      <a href={t.home}>{t.post.back}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 700px;
    padding: 64px 0 96px;
  }

  .post-header { display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
  .post-header time { font-size: 13px; color: var(--text-muted); }

  .comments-toggle {
    padding: 0; border: 0; background: none; cursor: pointer;
    font-size: 13px; color: var(--accent);
    text-decoration: underline dashed var(--cm-line); text-underline-offset: 4px;
  }
  .comments-toggle:hover { text-decoration-color: var(--accent); }

  h1 {
    margin: 0;
    font-size: 44px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .post-themes { margin: 0; font-size: 17px; font-style: italic; color: var(--text-muted); }

  .prose {
    font-size: 20px;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .prose :global(h2) {
    font-weight: 600;
    font-size: 28px;
    line-height: 1.3;
    color: var(--text);
    margin: 48px 0 16px;
  }

  .prose :global(h3) {
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: var(--text);
    margin: 36px 0 12px;
  }

  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(ul) { margin: 0 0 22px; padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(strong) { color: var(--text); }

  .prose :global(img),
  .prose :global(video) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 8px 0 24px;
  }

  .prose :global(pre) {
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 8px 0 24px;
  }

  .prose :global(code) { font-family: var(--mono); font-size: 0.85em; }

  .prose :global(p code) {
    background: var(--surface);
    border: 1px solid var(--rule-soft);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 2px 0 2px 22px;
    border-left: 3px solid var(--signal);
    font-style: italic;
    color: var(--text);
  }

  .prose :global(blockquote p) { margin: 0; }

  .post-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: 17px;
    color: var(--text-muted);
  }

  .post-footer p { margin: 0; font-style: italic; }

  @media (max-width: 760px) {
    article { padding: 40px 0 64px; }
    h1 { font-size: 32px; }
    .prose { font-size: 18px; }
    .prose :global(h2) { font-size: 24px; }
  }
</style>
