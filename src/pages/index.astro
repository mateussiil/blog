---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="Posts">
  <p class="intro">
    Notas sobre tecnologia e produtividade — o que aprendo usando IA no dia a dia,
    automações, e as ferramentas que ficam na minha stack.
  </p>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/blog/${post.id}/`}>
          {post.data.cover && (
            <Image
              class="cover"
              src={post.data.cover}
              alt={post.data.coverAlt}
              widths={[360, 720, 1080]}
              sizes="(max-width: 720px) 100vw, 672px"
            />
          )}
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}
          </time>
          <h2>{post.data.title}</h2>
          <p>{post.data.excerpt}</p>
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0 0 40px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    border-top: 1px solid var(--border);
  }

  .post-item a {
    display: block;
    padding: 24px 0;
    text-decoration: none;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: 16px;
  }

  .post-item time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .post-item h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 22px;
    margin: 6px 0 8px;
  }

  .post-item:hover h2 {
    color: var(--accent);
  }

  .post-item p {
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .tags {
    display: flex;
    gap: 8px;
  }

  .tag {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 10px;
  }
</style>
