---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from './PostRows.astro';
import { copy, LINKS, NAME, NOW_UPDATED, THEME_IDS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const en = lang === 'en';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.find((p) => p.data.featured);
// A home mostra só os mais recentes; a lista completa fica em /artigos/.
const HOME_POSTS = 5;
const recent = posts.filter((p) => p !== featured).slice(0, HOME_POSTS);

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
const destaque = projetos.find((p) => p.data.featured);
const outros = projetos.filter((p) => !p.data.featured);

// Abertura: até 3 projetos fixos na fileira de cima; os outros passam pelo rodízio embaixo.
const fixos = projetos.filter((p) => p.data.pinned).slice(0, 3);
const naFila = projetos.filter((p) => !fixos.includes(p));
const ROTATING_SLOTS = 3;
const noRodizio = naFila.slice(0, ROTATING_SLOTS);
const fila = naFila.slice(ROTATING_SLOTS);
// [x%, y%, giro] no computador e [x%, y px] no celular, um por lugar.
const TOP_SLOTS = [[17, 22, -3, 28, 92], [50, 13, 2, 72, 124], [83, 22, 3, 50, 186]];
const BOTTOM_SLOTS = [[15, 72, 3, 28, 392], [85, 72, -3, 72, 424], [50, 80, -2, 50, 484]];
const card = (p: (typeof projetos)[number], slot: number[], pinned: boolean) => ({
  id: p.id,
  name: p.data.name,
  desc: en ? p.data.descEn : p.data.desc,
  pinned,
  style: `--x:${slot[0]}%;--y:${slot[1]}%;--r:${slot[2]}deg;--mx:${slot[3]}%;--my:${slot[4]}px`,
});
const openingCards = [
  ...fixos.map((p, i) => card(p, TOP_SLOTS[i], true)),
  ...noRodizio.map((p, i) => card(p, BOTTOM_SLOTS[i], false)),
];
const queue = fila.map((p) => ({ id: p.id, name: p.data.name, desc: en ? p.data.descEn : p.data.desc }));
const [firstNames, lastName] = [NAME.split(' ').slice(0, -1).join(' '), NAME.split(' ').at(-1)];

const leituras = (await getCollection('leituras')).sort(
  (a, b) => Number(b.data.status === 'lendo') - Number(a.data.status === 'lendo')
);
const lendo = leituras.filter((l) => l.data.status === 'lendo');
const bookTitle = (l: (typeof leituras)[number]) => (en && l.data.titleEn) || l.data.title;

const lastTheme = THEME_IDS.length - 1;
const themeSep = (i: number) => (i === lastTheme ? '.' : i === lastTheme - 1 ? t.and : ',');
const badge = (postLang: Lang) => (postLang !== lang ? postLang.toUpperCase() : '');
---
<BaseLayout title={NAME} lang={lang} alternate={t.otherHome} canonical={t.home}>
  <Fragment slot="hero">
    <section class="opening" aria-label={NAME}>
      <div class="stage" data-opening>
        <div class="opening-name">
          <h1>{firstNames} <em>{lastName}</em><svg class="spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.6 6.5 5.5 11.4 12 12-6.5.6-11.4 5.5-12 12-.6-6.5-5.5-11.4-12-12C6.5 11.4 11.4 6.5 12 0Z" /></svg></h1>
          <p class="role">{t.role}</p>
        </div>
        <ul class="opening-cards" aria-label={t.opening.projects}>
          {openingCards.map((c) => (
            <li class:list={['oc', { 'oc-pinned': c.pinned }]} style={c.style} data-id={c.id}>
              <a href={`#projeto-${c.id}`}>
                <span class="oc-top">
                  <span class="oc-tile" aria-hidden="true">{c.name.charAt(0)}</span>
                  <span class="oc-name">{c.name}</span>
                  {c.pinned && <span class="oc-star" title={t.opening.pinned} aria-label={t.opening.pinned}>★</span>}
                </span>
                <span class="oc-desc">{c.desc}</span>
              </a>
            </li>
          ))}
        </ul>
        <script is:inline>
          // Antes da primeira pintura: esconde os cards para a abertura começar só com o nome.
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.closest('[data-opening]').classList.add('is-animating');
        </script>
      </div>
      <script type="application/json" id="opening-queue" set:html={JSON.stringify(queue)} />
    </section>
  </Fragment>

  <section id="sobre" class="about" aria-labelledby="sobre-title">
    <h2 id="sobre-title" class="eyebrow">{t.about}</h2>
    <div class="about-body">
      {t.bio.map((p) => <p class="bio">{p}</p>)}
      <p class="themes">
        {t.themesLead}{' '}
        {THEME_IDS.map((id, i) => (
          <><span class="nowrap"><a class="theme" href={`${t.articlesPath}?tema=${id}`}>{t.themes[id]}</a>{themeSep(i)}</span>{' '}</>
        ))}
      </p>
      <div class="cta">
        <a class="cta-primary" href={LINKS.linkedin} rel="noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          {t.linkedin}
        </a>
        <a class="cta-ghost" href={LINKS.github} rel="noreferrer">GitHub</a>
        <a class="cta-ghost" href={LINKS.medium} rel="noreferrer">Medium</a>
      </div>
    </div>

    <div class="now" id="agora">
      <div class="now-head">
        <h3><span class="dot" aria-hidden="true"></span>{t.now.title}</h3>
        <time class="mono" datetime={NOW_UPDATED.toISOString().slice(0, 10)}>{t.month(NOW_UPDATED)}</time>
      </div>
      <p>
        <Fragment set:html={t.now.working} />
        {lendo.length > 0 && (
          <>
            {' '}{t.now.reading}{' '}
            {lendo.map((l, i) => (
              <>
                <cite>{bookTitle(l)}</cite>, {t.now.by} {l.data.author}{i === lendo.length - 1 ? '.' : i === lendo.length - 2 ? `,${t.and}` : ', '}
              </>
            ))}
          </>
        )}
      </p>
    </div>
  </section>

  <section id="artigos" class="section">
    <div class="section-head">
      <h2><a href={t.articlesPath}>{t.articles.title}</a></h2>
      <a class="all-link" href={t.articlesPath}>{t.articles.all} ({posts.length}) →</a>
    </div>

    {featured && (
      <a class="featured-post" href={`/blog/${featured.id}/`} lang={featured.data.lang === 'en' ? 'en' : 'pt-BR'}>
        <div class="fpost-meta">
          <span class="pinned">{t.articles.pinned}</span>
          <time class="mono" datetime={featured.data.date.toISOString()}>{t.date(featured.data.date, 'long')}</time>
          {badge(featured.data.lang) && <span class="mono">{badge(featured.data.lang)}</span>}
        </div>
        <div class="fpost-body">
          <span class="fpost-title">{featured.data.title}</span>
          <span class="fpost-excerpt">{featured.data.excerpt}</span>
        </div>
      </a>
    )}

    <PostRows posts={recent} lang={lang} />
    {posts.length > recent.length + (featured ? 1 : 0) && (
      <a class="all-link all-bottom" href={t.articlesPath}>{t.articles.all} →</a>
    )}
  </section>

  <section id="projetos" class="section">
    <div class="section-head">
      <h2>{t.projects.title}</h2>
      <p class="section-sub">{t.projects.sub}</p>
    </div>

    {destaque && (
      <article class="featured-project" id={`projeto-${destaque.id}`}>
        <div class="fp-intro">
          <h3>{destaque.data.name}</h3>
          <p>{en ? destaque.data.descEn : destaque.data.desc}</p>
        </div>
        {destaque.data.sources && destaque.data.hub && (
          <div class="flow">
            <ul class="flow-sources">
              {destaque.data.sources.map((s) => (
                <li>
                  <span class="mono repo">{s.repo}</span>
                  <span>{en ? s.descEn : s.desc}</span>
                </li>
              ))}
            </ul>
            <svg class="flow-lines" width="56" height="240" viewBox="0 0 56 240" fill="none" aria-hidden="true">
              <path d="M0 40 C28 40 28 120 52 120" />
              <path d="M0 120 L52 120" />
              <path d="M0 200 C28 200 28 120 52 120" />
              <path d="M46 115 L53 120 L46 125" />
            </svg>
            <div class="flow-hub">
              <strong>{en ? destaque.data.hub.titleEn : destaque.data.hub.title}</strong>
              {destaque.data.hub.repos.map((r) => <span class="mono">{r}</span>)}
              <span class="hub-desc">{en ? destaque.data.hub.descEn : destaque.data.hub.desc}</span>
            </div>
          </div>
        )}
      </article>
    )}

    <div class="projects">
      {outros.map((p) => (
        <article id={`projeto-${p.id}`}>
          <h3>{p.data.url ? <a href={p.data.url} rel="noreferrer">{p.data.name}</a> : p.data.name}</h3>
          <p>{en ? p.data.descEn : p.data.desc}</p>
          <p class="project-themes">{p.data.themes.map((id) => t.themes[id]).join(', ')}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="consumindo" class="section section-last">
    <div class="section-head">
      <h2>{t.reading.title}</h2>
      <p class="section-sub">{t.reading.sub}</p>
    </div>
    <ul class="reading">
      {leituras.map((l) => (
        <li>
          <span class:list={['kind', { current: l.data.status === 'lendo' }]}>
            {t.reading.kinds[l.data.kind]}{l.data.status === 'lendo' && `, ${t.reading.now}`}
          </span>
          <div>
            <span class="reading-title">{l.data.url ? <a href={l.data.url} rel="noreferrer">{bookTitle(l)}</a> : bookTitle(l)}</span>
            <span class="reading-author">{l.data.author}</span>
            {(en ? l.data.noteEn ?? l.data.note : l.data.note) && (
              <span class="reading-note">{en ? l.data.noteEn ?? l.data.note : l.data.note}</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // Abertura: os cards entram um a um; depois, de tempos em tempos, um vem pra frente.
  // Os fixos têm a vez primeiro e nunca saem; os do rodízio, ao voltar, dão lugar ao próximo da fila.
  const stage = document.querySelector<HTMLElement>('[data-opening].is-animating');
  if (stage) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.oc'));
    const queue: { id: string; name: string; desc: string }[] = JSON.parse(document.getElementById('opening-queue')?.textContent || '[]');
    const pinned = cards.filter((c) => c.classList.contains('oc-pinned'));
    const ENTER_AT = 900, ENTER_GAP = 350, STEP = 2800;
    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(stage);

    const fill = (c: HTMLElement, p: { id: string; name: string; desc: string }) => {
      c.dataset.id = p.id;
      c.querySelector('a')!.setAttribute('href', `#projeto-${p.id}`);
      c.querySelector('.oc-tile')!.textContent = p.name.charAt(0);
      c.querySelector('.oc-name')!.textContent = p.name;
      c.querySelector('.oc-desc')!.textContent = p.desc;
    };

    cards.forEach((c, i) => setTimeout(() => c.classList.add('in'), ENTER_AT + i * ENTER_GAP));

    let front: HTMLElement | null = null;
    let pinnedTurn = 0;
    const step = () => {
      if (!visible || document.hidden) return;
      if (front) {
        const old = front;
        old.classList.remove('front');
        if (!old.classList.contains('oc-pinned') && queue.length) {
          setTimeout(() => {
            old.classList.add('swap');
            setTimeout(() => {
              queue.push({ id: old.dataset.id!, name: old.querySelector('.oc-name')!.textContent!, desc: old.querySelector('.oc-desc')!.textContent! });
              fill(old, queue.shift()!);
              old.classList.remove('swap');
            }, 500);
          }, 700);
        }
      }
      if (pinnedTurn < pinned.length) front = pinned[pinnedTurn++];
      else {
        const others = cards.filter((c) => c !== front);
        front = others[Math.floor(Math.random() * others.length)] ?? front;
      }
      front?.classList.add('front');
    };
    setTimeout(() => { step(); setInterval(step, STEP); }, ENTER_AT + cards.length * ENTER_GAP + 600);
  }
</script>

<style>
  /* Abertura: o nome no centro, 3 projetos fixos em cima e o rodízio embaixo. */
  .opening { padding: 0 24px; }

  .stage {
    position: relative;
    max-width: 1180px;
    height: clamp(540px, calc(100svh - 200px), 760px);
    margin: 0 auto;
    isolation: isolate;
  }

  /* Sol de raios da referência, discreto no canto. */
  .stage::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 220px;
    height: 220px;
    right: 3%;
    bottom: -70px;
    border-radius: 50%;
    background: repeating-conic-gradient(var(--orange) 0 5deg, transparent 5deg 15deg);
    -webkit-mask: radial-gradient(circle, transparent 0 14%, #000 15%);
    mask: radial-gradient(circle, transparent 0 14%, #000 15%);
    opacity: 0.85;
  }

  .opening-name {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    gap: 14px;
    text-align: center;
    pointer-events: none;
  }

  h1 {
    margin: 0;
    font-size: clamp(56px, 8.4vw, 112px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--text);
    text-wrap: balance;
  }

  h1 em { font-style: normal; color: var(--accent); }
  .spark { width: 0.26em; height: 0.26em; margin-left: 0.04em; vertical-align: top; fill: var(--orange); }

  .role { margin: 0; font-size: 19px; font-style: italic; color: var(--text-muted); }

  .opening-cards { list-style: none; margin: 0; padding: 0; }

  .oc {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 1;
    width: 230px;
    transform: translate(-50%, -50%) scale(0.86) rotate(var(--r));
    opacity: 0.85;
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s, box-shadow 0.9s;
  }

  .oc.oc-pinned { z-index: 3; opacity: 1; transform: translate(-50%, -50%) scale(0.94) rotate(var(--r)); }

  .oc a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--rule-soft);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
  }

  .oc a:hover .oc-name { color: var(--accent); }

  .oc-top { display: flex; align-items: center; gap: 10px; }

  .oc-tile {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--tile);
    font-weight: 600;
  }

  .oc-name { font-size: 17px; font-weight: 600; }
  .oc-star { margin-left: auto; color: var(--orange); font-size: 15px; line-height: 1; }

  .oc-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-muted);
  }

  /* Com movimento: começa só com o nome; o script faz os cards entrarem e virem pra frente. */
  .is-animating .oc { opacity: 0; transform: translate(-50%, -50%) scale(0.6) rotate(var(--r)); }
  .is-animating .oc.in { opacity: 0.85; transform: translate(-50%, -50%) scale(0.86) rotate(var(--r)); }
  .is-animating .oc.oc-pinned.in { opacity: 1; transform: translate(-50%, -50%) scale(0.94) rotate(var(--r)); }
  .is-animating .oc.front { z-index: 5; opacity: 1; transform: translate(-50%, -50%) scale(1.1) rotate(0deg); }
  .is-animating .oc.front a { box-shadow: var(--shadow-lg); }
  .is-animating .oc.swap { opacity: 0; transform: translate(-50%, -50%) scale(0.7) rotate(var(--r)); }

  /* Sobre: começa logo abaixo da abertura, com o topo aparecendo na primeira tela. */
  .about {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 8px;
    padding: 48px 56px 52px;
    border: 1px solid var(--rule-soft);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 -12px 30px -22px rgba(60, 40, 10, 0.45);
    scroll-margin-top: 24px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .about-body { display: flex; flex-direction: column; gap: 24px; }

  .bio {
    margin: 0;
    font-size: 22px;
    line-height: 1.55;
    max-width: 36em;
    color: var(--text-soft);
  }

  .themes {
    margin: 0;
    font-size: 22px;
    line-height: 1.7;
    max-width: 36em;
    color: var(--text-muted);
  }

  .nowrap { white-space: nowrap; }

  .theme {
    padding: 0 2px;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--signal-soft);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .theme:hover { color: var(--accent); text-decoration-color: var(--signal); }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }

  .cta a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 17px;
    text-decoration: none;
  }

  .cta .cta-primary {
    background: linear-gradient(180deg, var(--signal-soft), var(--signal));
    color: var(--on-signal);
    font-weight: 600;
    box-shadow: 0 6px 14px -6px rgba(242, 165, 22, 0.7);
  }

  .cta .cta-primary:hover { color: var(--on-signal); filter: brightness(1.04); }

  .cta .cta-ghost {
    border: 1px solid var(--rule);
    color: var(--text-soft);
  }

  .cta .cta-ghost:hover { border-color: var(--accent); color: var(--accent); }

  .now {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    align-items: baseline;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .now-head { display: flex; flex-direction: column; gap: 4px; }

  .now h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    font-style: italic;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px rgba(232, 80, 30, 0.18);
  }

  .now time {
    padding-left: 19px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .now p {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    max-width: 40em;
    color: var(--text-soft);
  }

  .now p :global(strong), .now cite { color: var(--text); }

  .section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 64px 0;
    border-top: 1px solid var(--rule);
  }

  .about + .section { border-top: 0; }
  .section-last { padding-bottom: 96px; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .section-sub {
    margin: 0;
    font-size: 17px;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Projetos */
  .featured-project {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 40px;
    border: 1px solid var(--rule-soft);
    border-radius: 10px;
    background: var(--surface);
  }

  .fp-intro { display: flex; flex-direction: column; gap: 10px; max-width: 40em; }
  .fp-intro h3 { margin: 0; font-size: 32px; font-weight: 700; }
  .fp-intro p { margin: 0; font-size: 19px; line-height: 1.6; color: var(--text-soft); }

  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px 260px;
    align-items: center;
  }

  .flow-sources {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .flow-sources li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    background: var(--paper);
    font-size: 16px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .repo { font-size: 14px; font-weight: 500; color: var(--text); }

  .flow-lines path { stroke: var(--accent); stroke-width: 1.5; }

  .flow-hub {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: 6px;
    background: var(--band);
    color: var(--band-muted);
    font-size: 13px;
  }

  .flow-hub strong { font-size: 21px; color: #ffffff; }
  .hub-desc { font-family: var(--serif); font-size: 15px; line-height: 1.45; color: var(--band-text); }

  .projects {
    display: grid;
