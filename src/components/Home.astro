---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from './PostRows.astro';
import { copy, LINKS, NOW_UPDATED, THEME_IDS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const en = lang === 'en';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.find((p) => p.data.featured);
// A home mostra só os mais recentes; a lista completa fica em /artigos/.
const HOME_POSTS = 5;
const recent = posts.filter((p) => p !== featured).slice(0, HOME_POSTS);

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
const destaque = projetos.find((p) => p.data.featured);
const outros = projetos.filter((p) => !p.data.featured);

const leituras = (await getCollection('leituras')).sort(
  (a, b) => Number(b.data.status === 'lendo') - Number(a.data.status === 'lendo')
);
const lendo = leituras.filter((l) => l.data.status === 'lendo');
const bookTitle = (l: (typeof leituras)[number]) => (en && l.data.titleEn) || l.data.title;

const lastTheme = THEME_IDS.length - 1;
const themeSep = (i: number) => (i === lastTheme ? '.' : i === lastTheme - 1 ? t.and : ',');
const badge = (postLang: Lang) => (postLang !== lang ? postLang.toUpperCase() : '');
---
<BaseLayout title="Mateus Silva" lang={lang} alternate={t.otherHome} canonical={t.home}>
  <Fragment slot="hero">
    <section class="hero">
      <h1>Mateus Silva</h1>
      {t.bio.map((p) => <p class="bio">{p}</p>)}
      <p class="themes">
        {t.themesLead}{' '}
        {THEME_IDS.map((id, i) => (
          <><span class="nowrap"><a class="theme" href={`${t.articlesPath}?tema=${id}`}>{t.themes[id]}</a>{themeSep(i)}</span>{' '}</>
        ))}
      </p>
      <div class="cta">
        <a class="cta-primary" href={LINKS.linkedin} rel="noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          {t.linkedin}
        </a>
        <a class="cta-ghost" href={LINKS.github} rel="noreferrer">GitHub</a>
        <a class="cta-ghost" href={LINKS.medium} rel="noreferrer">Medium</a>
      </div>
    </section>

    <section class="now" id="agora" aria-labelledby="agora-title">
      <div class="now-head">
        <h2 id="agora-title"><span class="dot" aria-hidden="true"></span>{t.now.title}</h2>
        <time class="mono" datetime={NOW_UPDATED.toISOString().slice(0, 10)}>{t.month(NOW_UPDATED)}</time>
      </div>
      <p>
        <Fragment set:html={t.now.working} />
        {lendo.length > 0 && (
          <>
            {' '}{t.now.reading}{' '}
            {lendo.map((l, i) => (
              <>
                <cite>{bookTitle(l)}</cite>, {t.now.by} {l.data.author}{i === lendo.length - 1 ? '.' : i === lendo.length - 2 ? `,${t.and}` : ', '}
              </>
            ))}
          </>
        )}
      </p>
    </section>
  </Fragment>

  <section id="projetos" class="section">
    <div class="section-head">
      <h2>{t.projects.title}</h2>
      <p class="section-sub">{t.projects.sub}</p>
    </div>

    {destaque && (
      <article class="featured-project">
        <div class="fp-intro">
          <h3>{destaque.data.name}</h3>
          <p>{en ? destaque.data.descEn : destaque.data.desc}</p>
        </div>
        {destaque.data.sources && destaque.data.hub && (
          <div class="flow">
            <ul class="flow-sources">
              {destaque.data.sources.map((s) => (
                <li>
                  <span class="mono repo">{s.repo}</span>
                  <span>{en ? s.descEn : s.desc}</span>
                </li>
              ))}
            </ul>
            <svg class="flow-lines" width="56" height="240" viewBox="0 0 56 240" fill="none" aria-hidden="true">
              <path d="M0 40 C28 40 28 120 52 120" />
              <path d="M0 120 L52 120" />
              <path d="M0 200 C28 200 28 120 52 120" />
              <path d="M46 115 L53 120 L46 125" />
            </svg>
            <div class="flow-hub">
              <strong>{en ? destaque.data.hub.titleEn : destaque.data.hub.title}</strong>
              {destaque.data.hub.repos.map((r) => <span class="mono">{r}</span>)}
              <span class="hub-desc">{en ? destaque.data.hub.descEn : destaque.data.hub.desc}</span>
            </div>
          </div>
        )}
      </article>
    )}

    <div class="projects">
      {outros.map((p) => (
        <article>
          <h3>{p.data.url ? <a href={p.data.url} rel="noreferrer">{p.data.name}</a> : p.data.name}</h3>
          <p>{en ? p.data.descEn : p.data.desc}</p>
          <p class="project-themes">{p.data.themes.map((id) => t.themes[id]).join(', ')}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="artigos" class="section">
    <div class="section-head">
      <h2><a href={t.articlesPath}>{t.articles.title}</a></h2>
      <a class="all-link" href={t.articlesPath}>{t.articles.all} ({posts.length}) →</a>
    </div>

    {featured && (
      <a class="featured-post" href={`/blog/${featured.id}/`} lang={featured.data.lang === 'en' ? 'en' : 'pt-BR'}>
        <div class="fpost-meta">
          <span class="pinned">{t.articles.pinned}</span>
          <time class="mono" datetime={featured.data.date.toISOString()}>{t.date(featured.data.date, 'long')}</time>
          {badge(featured.data.lang) && <span class="mono">{badge(featured.data.lang)}</span>}
        </div>
        <div class="fpost-body">
          <span class="fpost-title">{featured.data.title}</span>
          <span class="fpost-excerpt">{featured.data.excerpt}</span>
        </div>
      </a>
    )}

    <PostRows posts={recent} lang={lang} />
    {posts.length > recent.length + (featured ? 1 : 0) && (
      <a class="all-link all-bottom" href={t.articlesPath}>{t.articles.all} →</a>
    )}
  </section>

  <section id="consumindo" class="section section-last">
    <div class="section-head">
      <h2>{t.reading.title}</h2>
      <p class="section-sub">{t.reading.sub}</p>
    </div>
    <ul class="reading">
      {leituras.map((l) => (
        <li>
          <span class:list={['kind', { current: l.data.status === 'lendo' }]}>
            {t.reading.kinds[l.data.kind]}{l.data.status === 'lendo' && `, ${t.reading.now}`}
          </span>
          <div>
            <span class="reading-title">{l.data.url ? <a href={l.data.url} rel="noreferrer">{bookTitle(l)}</a> : bookTitle(l)}</span>
            <span class="reading-author">{l.data.author}</span>
            {(en ? l.data.noteEn ?? l.data.note : l.data.note) && (
              <span class="reading-note">{en ? l.data.noteEn ?? l.data.note : l.data.note}</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 88px 0 72px;
  }

  h1 {
    margin: 0 0 4px;
    font-size: 84px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
    color: #ffffff;
  }

  .bio {
    margin: 0;
    font-size: 24px;
    line-height: 1.55;
    max-width: 34em;
  }

  .themes {
    margin: 0;
    font-size: 24px;
    line-height: 1.7;
    max-width: 34em;
    color: var(--band-muted);
  }

  .nowrap { white-space: nowrap; }

  .theme {
    background: none;
    border: 0;
    padding: 0 2px;
    margin: 0;
    font: inherit;
    color: #ffffff;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: rgba(232, 176, 75, 0.55);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .theme:hover { text-decoration-color: var(--signal); }

  .theme[aria-pressed='true'] {
    background: var(--signal);
    color: var(--band);
    border-radius: 3px;
    text-decoration: none;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .cta a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 6px;
    font-size: 17px;
  }

  .cta .cta-primary {
    background: #ffffff;
    color: var(--band);
    font-weight: 600;
  }

  .cta .cta-primary:hover { background: #dff2ee; color: var(--band); }

  .cta .cta-ghost {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: var(--band-text);
  }

  .now {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    align-items: baseline;
    padding: 32px 0 44px;
    border-top: 1px solid var(--band-rule);
  }

  .now-head { display: flex; flex-direction: column; gap: 4px; }

  .now h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    font-style: italic;
    color: #ffffff;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgba(232, 176, 75, 0.2);
  }

  .now time {
    padding-left: 19px;
    font-size: 13px;
    color: var(--band-muted);
  }

  .now p {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    max-width: 40em;
  }

  .now p :global(strong), .now cite { color: #ffffff; }

  .section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 64px 0;
    border-top: 1px solid var(--rule);
  }

  .section:first-child { border-top: 0; padding-top: 80px; }
  .section-last { padding-bottom: 96px; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .section-head h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .section-sub {
    margin: 0;
    font-size: 17px;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Projetos */
  .featured-project {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 40px;
    border: 1px solid var(--rule-soft);
    border-radius: 10px;
    background: var(--surface);
  }

  .fp-intro { display: flex; flex-direction: column; gap: 10px; max-width: 40em; }
  .fp-intro h3 { margin: 0; font-size: 32px; font-weight: 700; }
  .fp-intro p { margin: 0; font-size: 19px; line-height: 1.6; color: var(--text-soft); }

  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px 260px;
    align-items: center;
  }

  .flow-sources {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .flow-sources li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    background: var(--paper);
    font-size: 16px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .repo { font-size: 14px; font-weight: 500; color: var(--text); }

  .flow-lines path { stroke: var(--accent); stroke-width: 1.5; }

  .flow-hub {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: 6px;
    background: var(--band);
    color: var(--band-muted);
    font-size: 13px;
  }

  .flow-hub strong { font-size: 21px; color: #ffffff; }
  .hub-desc { font-family: var(--serif); font-size: 15px; line-height: 1.45; color: var(--band-text); }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }

  .projects article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 0 28px;
    border-top: 1px solid var(--rule);
  }

  .projects h3 { margin: 0; font-size: 23px; font-weight: 600; }
  .projects h3 a { color: inherit; }
  .projects p { margin: 0; font-size: 17px; line-height: 1.55; color: var(--text-soft); }
  .projects .project-themes { font-size: 15px; font-style: italic; color: var(--text-muted); }

  /* Artigos */
  .section-head h2 a { color: inherit; text-decoration: none; }
  .section-head h2 a:hover { color: var(--accent); }

  .all-link {
    font-size: 17px;
    color: var(--accent);
    text-decoration: none;
  }

  .all-link:hover { text-decoration: underline; }
  .all-bottom { align-self: flex-start; }

  .featured-post {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    padding: 36px 40px;
    border: 1px solid var(--rule-soft);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .fpost-meta { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--text-muted); }
  .pinned { font-size: 16px; font-style: italic; color: var(--accent); }
  .fpost-body { display: flex; flex-direction: column; gap: 14px; }

  .fpost-title {
    font-size: 38px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .fpost-excerpt { font-size: 19px; line-height: 1.6; color: var(--text-soft); max-width: 36em; }
  .featured-post:hover .fpost-title { color: var(--accent); }

  /* Consumindo */
  .reading { list-style: none; margin: 0; padding: 0; }

  .reading li {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
  }

  .reading li > div { display: flex; flex-direction: column; gap: 4px; }
  .kind { padding-top: 3px; font-size: 16px; font-style: italic; color: var(--text-muted); }
  .kind.current { color: var(--accent); }
  .reading-title { font-size: 21px; font-weight: 600; }
  .reading-title a { color: inherit; }
  .reading-author { font-size: 16px; color: var(--text-muted); }
  .reading-note { padding-top: 4px; font-size: 18px; font-style: italic; line-height: 1.55; color: var(--text-soft); }

  @media (max-width: 760px) {
    .hero { gap: 22px; padding: 48px 0 48px; }
    h1 { font-size: 52px; }
    .bio, .themes { font-size: 20px; }
    .now, .featured-post, .reading li { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .section { padding: 48px 0; }
    .section:first-child { padding-top: 56px; }
    .section-head h2 { font-size: 32px; }
    .featured-project, .featured-post { padding: 24px; }
    .flow { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .flow-lines { display: none; }
    .projects { grid-template-columns: minmax(0, 1fr); }
    .fpost-meta { flex-direction: row; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
    .fpost-title { font-size: 28px; }
    .reading-title { font-size: 19px; }
  }
</style>
