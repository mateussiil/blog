---
import { copy, LINKS, NAME, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  // Página equivalente no outro idioma (só a home tem hoje).
  alternate?: string;
  canonical?: string;
}
const { title, description, lang = 'pt', alternate, canonical } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description ?? t.bio[0]} />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={new URL(canonical, Astro.site)} />}
  {alternate && <link rel="alternate" hreflang={copy[other].htmlLang} href={new URL(alternate, Astro.site)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="top">
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href={t.home}>{NAME.toLowerCase()}</a>
        <nav aria-label="Principal">
          <a href={`${t.home}#projetos`}>{t.nav.projects}</a>
          <a href={t.articlesPath}>{t.nav.articles}</a>
          <a href={`${t.home}#consumindo`}>{t.nav.reading}</a>
          <span class="lang-switch">
            <a href="/" aria-current={lang === 'pt' ? 'true' : undefined} hreflang="pt-BR" lang="pt-BR">PT</a>
            <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined} hreflang="en" lang="en">EN</a>
          </span>
        </nav>
      </header>
    </div>
    <slot name="hero" />
  </div>

  <main class="wrap">
    <slot />
  </main>

  <footer class="band site-footer">
    <div class="wrap footer-inner">
      <span>{NAME}, {new Date().getFullYear()}</span>
      <span class="footer-links">
        <a href={LINKS.linkedin} rel="noreferrer">LinkedIn</a>
        <a href={LINKS.github} rel="noreferrer">GitHub</a>
        <a href={LINKS.medium} rel="noreferrer">Medium</a>
      </span>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* Paleta: creme de fundo, índigo para ênfase, laranja do sol de raios, âmbar para foco e chamadas. */
  :root {
    --paper: #f6efe3;
    --surface: #fffaf2;
    --tile: #f1e2c6;
    --text: #17151f;
    --text-soft: #3a3646;
    --text-muted: #6a6574;
    --rule: #e3d4bb;
    --rule-soft: #ebdfcb;
    --accent: #4a4fd6;
    --accent-hover: #383cb8;
    --accent-soft: #e7e6fb;
    --orange: #e8501e;
    --signal: #f2a516;
    --signal-soft: #fbcb57;
    --on-signal: #2a1d05;
    --band: #1e1b30;
    --band-text: #f3ead9;
    --band-muted: #b9b2c6;
    --band-rule: rgba(255, 255, 255, 0.16);
    --shadow: 0 1px 2px rgba(60, 40, 10, 0.06);
    --shadow-lg: 0 18px 30px -10px rgba(60, 40, 10, 0.28), 0 4px 10px -4px rgba(60, 40, 10, 0.1);
    --serif: 'Source Serif 4', Georgia, serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #15131d;
      --surface: #1d1a28;
      --tile: #2a2233;
      --text: #f6efe3;
      --text-soft: #ddd4c4;
      --text-muted: #a59fb0;
      --rule: #2c2839;
      --rule-soft: #2c2839;
      --accent: #9b9eff;
      --accent-hover: #bfc1ff;
      --accent-soft: #2a2a5a;
      --orange: #f26a3a;
      --band: #0f0d16;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      --shadow-lg: 0 18px 30px -10px rgba(0, 0, 0, 0.6);
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }

  [hidden] { display: none !important; }

  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--text);
    font-family: var(--serif);
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--accent); }
  a:hover { color: var(--accent-hover); }
  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .band {
    background: var(--band);
    color: var(--band-text);
  }

  .band a { color: var(--band-muted); text-decoration: none; }
  .band a:hover { color: var(--band-text); }

  .top { background: var(--paper); }
  .top .site-header a { color: var(--text-muted); text-decoration: none; }
  .top .site-header a:hover { color: var(--text); }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding: 28px 0;
  }

  .top .site-header .brand {
    color: var(--text);
    font-weight: 600;
    font-size: 19px;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 16px;
  }

  .lang-switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .top .lang-switch a {
    font-family: var(--mono);
    font-size: 13px;
    min-width: 40px;
    padding: 5px 10px;
    border-radius: 999px;
    text-align: center;
  }

  .top .lang-switch a[aria-current] {
    background: var(--accent);
    color: var(--surface);
  }

  .site-footer { margin-top: 0; }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 32px;
    padding-bottom: 44px;
    color: var(--band-muted);
  }

  .footer-links { display: flex; gap: 24px; }

  .mono { font-family: var(--mono); }

  @media (max-width: 760px) {
    .wrap { padding: 0 20px; }
    .site-header nav { gap: 10px 18px; font-size: 15px; }
  }
</style>
